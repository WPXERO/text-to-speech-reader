{
	"name": "text-to-speech-reader",
	"version": "1.0.0",
	"private": true,
	"description": "Development tooling for the Text to Speech Reader WordPress plugin. Not shipped in the plugin package.",
	"license": "GPL-3.0-or-later",
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/compose": "^9.0.0",
		"@wordpress/core-data": "^9.0.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/dependency-extraction-webpack-plugin": "^7.0.0",
		"@wordpress/dom-ready": "^5.0.0",
		"@wordpress/editor": "^16.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/hooks": "^5.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/icons": "^19.0.0",
		"@wordpress/plugins": "^8.0.0",
		"@wordpress/scripts": "^37.0.0",
		"jsdom": "^30.1.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "^5.9.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"scripts": {
		"start": "wp-scripts start",
		"build": "wp-scripts build",
		"typecheck": "tsc -p tsconfig.json",
		"lint:js": "wp-scripts lint-js src tests/js bin",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"lint:php": "composer lint",
		"lint:php-syntax": "node bin/php-syntax.mjs",
		"lint": "npm run typecheck && npm run lint:js && npm run lint:css && npm run lint:php-syntax && npm run lint:php",
		"format": "wp-scripts format src tests/js bin",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:wp": "node bin/test-wp.mjs",
		"makepot": "node bin/makepot.mjs",
		"check-versions": "node bin/check-versions.mjs",
		"package": "node bin/package.mjs",
		"verify-package": "node bin/verify-package.mjs",
		"release": "node bin/release.mjs"
	}
}
