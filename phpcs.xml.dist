<?xml version="1.0"?>
<ruleset name="Text to Speech Reader">
	<description>WordPress Coding Standards for Text to Speech Reader.</description>

	<file>.</file>

	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg value="sp"/>
	<arg name="colors"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.6"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress">
		<!-- Classes are namespaced and autoloaded as Namespace/Class_Name.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="text-to-speech-reader"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ttsr"/>
				<element value="TTSR"/>
			</property>
		</properties>
	</rule>

	<rule ref="Squiz.Commenting.FileComment.Missing">
		<exclude-pattern>/tests/php/*</exclude-pattern>
	</rule>
</ruleset>
